# OpenClaw Watchdog Configuration
# Copy to .env and fill in your values

# =============================================================================
# SSH CONNECTION (Required)
# =============================================================================
# How to connect to your OpenClaw host
SSH_USER="root"
SSH_HOST="your-vps.example.com"
SSH_KEY="~/.ssh/id_ed25519"
SSH_PORT="22"

# =============================================================================
# NOTIFICATIONS (Optional - configure at least one)
# =============================================================================

# Telegram
# Get bot token from @BotFather, chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ntfy (https://ntfy.sh or self-hosted)
NTFY_TOPIC=""
NTFY_SERVER="https://ntfy.sh"  # Optional, defaults to ntfy.sh

# Discord Webhook
# Create webhook in Discord: Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=""

# =============================================================================
# BEHAVIOR
# =============================================================================
CHECK_INTERVAL="120"          # Seconds between health checks
MAX_REPAIR_ATTEMPTS="2"       # Repair attempts before notifying
LOG_RETENTION_DAYS="7"        # Days to keep log files
